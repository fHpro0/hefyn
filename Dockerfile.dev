# Dev image on Bun (the same pinned version as production). node_modules stays in the image (Linux native binaries); sources
# arrive through Compose Watch, never a bind mount. procps: `concurrently -k` needs ps to stop its children.
FROM oven/bun:1.4.4
RUN apt-get update && apt-get install -y --no-install-recommends procps && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json bun.lock* ./
COPY vendor ./vendor
RUN bun install --frozen-lockfile
COPY . .
ENV HEFYN_DATA_DIR=/data HEFYN_DEV_HOST=0.0.0.0
VOLUME /data
CMD ["bun", "run", "dev:web:docker"]
