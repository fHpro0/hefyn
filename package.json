  "engines": {
    "bun": ">=1.4.4"
  },
  "packageManager": "bun@1.4.4",
  "scripts": {
    "readme:art": "bun scripts/readme-art.ts",
    "dev": "concurrently -k -n agent,web \"bun run dev:agent\" \"bun run dev:web\"",
    "build": "bun web/build.ts",
    "start": "bun src/agent.ts",
    "start:web": "bun src/web.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "test": "bun scripts/test.ts",
    "device": "bun device/cli.ts",
    "dev:agent": "PORT=${HEFYN_AGENT_PORT:-5174} bun --watch src/agent.ts",
    "dev:web": "concurrently -k -n api,ui \"PORT=5173 bun --watch src/web.ts\" \"bun web/serve.ts\"",
    "dev:web:docker": "concurrently -k -n api,ui \"PORT=5173 bun --watch src/web.ts\" \"HEFYN_DEV_HOST=0.0.0.0 bun web/serve.ts\"",
    "dev:docker": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up --watch",
    "init": "bun scripts/init-env.ts",
    "openui:skill": "bun scripts/openui-skill.ts"
  },
