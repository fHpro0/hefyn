# `bun run init` creates .env from this file and replaces every dev-only value with a random one.
# 32+ random characters: encrypts stored API keys and signs sessions. Losing it makes stored keys unreadable.
HEFYN_SECRET=dev-only-secret-do-not-use-in-production
# Shared secret between the services (agent <-> web <-> runner <-> egress proxy). Use hex/base64url: it is embedded in a proxy URL.
HEFYN_INTERNAL_TOKEN=dev-only-internal-token
# Public URL users open (used for auth cookies/CSRF checks).
HEFYN_URL=http://localhost:3000
# GLiNER PII model in the redact service: on (default; web downloads ~86 MB into the redact-models volume on first start) or off.
# In production GLiNER is mandatory: off also needs HEFYN_ALLOW_NO_GLINER=1 (dev/test only; the UI shows a red warning).
HEFYN_REDACT_GLINER=on
#HEFYN_ALLOW_NO_GLINER=1
# Optional: where the GLiNER files live (default ${HEFYN_DATA_DIR}/models/gliner) and where web downloads them from (default: Hugging Face; files are pinned by SHA-256).
# redact service: worker threads for regex/entropy/guard (default 2), their hard per-job timeout in ms (default 10000; on timeout the request
# is blocked), and its container limits.
#HEFYN_REDACT_CPUS=2
#HEFYN_REDACT_MEMORY=1536m
#HEFYN_REDACT_WORKERS=2
#HEFYN_REDACT_TIMEOUT_MS=10000
#HEFYN_REDACT_MODEL_DIR=
#HEFYN_REDACT_MODEL_URL=
# How long a requested agent restart waits for running tasks before restarting anyway (ms).
HEFYN_DRAIN_TIMEOUT_MS=600000
